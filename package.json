{
  "name": "changdu-memory",
  "private": true,
  "version": "5.1.5",
  "type": "module",
  "description": "昌都记忆 Changdu Memory - 个人数字记录平台",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext .vue,.ts,.tsx",
    "format": "prettier --write \"src/**/*.{vue,ts,tsx,css}\"",
    "type-check": "vue-tsc -b --noEmit"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.4",
    "naive-ui": "^2.41.0",
    "pinia": "^2.3.1",
    "vue": "^3.5.18",
    "vue-router": "^4.5.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.2",
    "@vitejs/plugin-vue": "^5.2.4",
    "eslint": "^10.8.0",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.8.0",
    "prettier": "^3.9.6",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^6.3.5",
    "vite-plugin-pwa": "^0.21.2",
    "vue-tsc": "^2.2.12"
