# =============================================
# 昌都记忆 Changdu Memory V5.1.5 — 环境变量配置
# =============================================
# 复制此文件为 .env 并填入实际值
# .env 文件已被 .gitignore 忽略，请勿提交

# Supabase 项目 URL（在 Supabase Dashboard > Settings > API 中获取）
VITE_SUPABASE_URL=https://your-project.supabase.co

# Supabase Anon Key（公开密钥，前端安全使用）
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# =============================================
# 保活函数专用（可选）—— 只在 Vercel 服务端使用，不进前端 bundle
# =============================================
# 以下变量请配置在 Vercel Dashboard > Settings > Environment Variables，
# 无需写入本地 .env。service_role 密钥在 Supabase Dashboard > Settings > API 中复制。
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
